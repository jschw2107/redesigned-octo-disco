# --- Admin ---
ADMIN_PASSWORD=change-me
# Any long random string; signs the admin login cookie
SESSION_SECRET=

# --- Public URL (used in emails and payment redirects) ---
SITE_URL=https://your-domain.com

# --- Database (Turso / libSQL). Leave empty locally to use ./data/groupbuy.db ---
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Online payments (Stripe). Leave empty to use "pay at pickup" ---
# Use sk_test_... while testing, sk_live_... when you go live
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend). Leave empty to print emails to the server log ---
RESEND_API_KEY=
# Must be on a domain you verified in Resend, e.g. "GroupBuy <orders@yourdomain.com>"
EMAIL_FROM=
# Where student replies go (e.g. your Gmail)
EMAIL_REPLY_TO=
# Gets an email for every new order (optional)
ADMIN_EMAIL=
